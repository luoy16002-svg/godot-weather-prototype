; Engine configuration file.
config_version=5

[application]

config/name="Weather Prototype"
config/description="Ambient 3D weather technical prototype: rain, wind, lightning, thunder and layered audio."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Weather="*res://weather/weather.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[input]

toggle_panel={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":72,"key_label":0,"unicode":104,"location":0,"echo":false,"script":null)
]
}
strike_now={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":76,"key_label":0,"unicode":108,"location":0,"echo":false,"script":null)
]
}

[shader_globals]

wind={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
wetness={
"type": "float",
"value": 0.0
}
